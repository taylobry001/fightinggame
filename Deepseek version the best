      <label>Stocks: <input type="number" id="stockCount" value="3" min="1" max="10"></label>
      <label>AI Diff: <input type="range" id="aiDiff" min="1" max="5" value="3"></label>
      <label>Name: <input type="text" id="playerNameInput" value="You" maxlength="16"></label>
      <label>Volume: <input type="range" min="0" max="100" value="80"></label>
    </div>
    <button onclick="applySettings()" style="background:#4488ff;border:none;color:#fff;padding:8px;border-radius:8px;cursor:pointer;margin-top:8px;width:100%;">Apply</button>
  </div>
  
  <!-- Dev Console -->
  <div id="devConsole">
    <div id="devOutput"></div>
    <input type="text" id="devInput" placeholder="Type command..." onkeydown="handleDevCommand(event)">
  </div>
  
  <!-- Kill Feed -->
  <div id="killFeed"></div>
  
  <!-- Notifications -->
  <div id="notificationContainer"></div>
  
  <!-- Main Menu -->
  <div class="menu-overlay" id="mainMenu">
    <div class="menu-title">⚔️ COMBO CLASH</div>
    <button class="menu-btn" onclick="startGame('local')">🎮 LOCAL VS AI</button>
    <button class="menu-btn secondary" onclick="startGame('host')">🌟 HOST PARTY</button>
    <button class="menu-btn secondary" onclick="startGame('join')">🔗 JOIN PARTY</button>
    <button class="menu-btn gold" id="dioCharBtn" onclick="selectDIO()">🌍 DIO (The World)</button>
    <button class="menu-btn" onclick="showFullSettings()" style="background:#333;border-color:#666;">⚙️ SETTINGS</button>
  </div>
  
  <!-- Full Settings Menu -->
  <div class="menu-overlay hidden" id="fullSettingsMenu">
    <div class="menu-title" style="font-size:2rem;">⚙️ SETTINGS</div>
    <div class="settings-grid" style="width:450px;">
      <label>Stocks: <input type="number" id="fsStockCount" value="3" min="1" max="10"></label>
      <label>AI Difficulty: <input type="range" id="fsAiDiff" min="1" max="5" value="3"></label>
      <label>Player Name: <input type="text" id="fsPlayerName" value="You" maxlength="16"></label>
      <label>Friend Code: <div class="friend-code-display" id="fsFriendCode">----</div></label>
      <label>Sprite (PNG): <input type="file" id="p1SpriteInput" accept="image/png"></label>
      <label>Filter Slurs: <input type="checkbox" id="filterSlurs" checked></label>
      <label>Ban List: <textarea id="banListDisplay" readonly rows="3" style="resize:none;font-size:10px;">No banned users</textarea></label>
    </div>
    <button class="menu-btn" onclick="backToMenu()">🔙 BACK</button>
  </div>
  
  <!-- Damage numbers layer -->
  <div id="damageLayer" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;"></div>
</div>

<script>
// ============ WORD FILTER SYSTEM ============
const SLUR_LIST = [
  'nigger', 'nigga', 'n1gger', 'n1gga', 'nigg3r', 'nigg3a',
  'faggot', 'fag', 'f4ggot', 'f4g',
  'retard', 'r3tard', 'ret4rd',
  'kike', 'k1ke', 'kyke',
  'chink', 'ch1nk', 'ch1ng',
  'spic', 'sp1c', 'sp1k',
  'wetback', 'w3tback',
  'tranny', 'tr4nny',
  'dyke', 'd1ke', 'dyk3',
  'homo', 'h0mo' // common slurs
];

const BANNED_WORDS = new Set(SLUR_LIST);

function filterText(text) {
  if (!text) return '';
  const filterEnabled = document.getElementById('filterSlurs')?.checked ?? true;
  if (!filterEnabled) return text;
  
  let filtered = text;
  // Check against slur list (case insensitive)
  BANNED_WORDS.forEach(slur => {
    const regex = new RegExp(slur.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
    filtered = filtered.replace(regex, '****');
  });
  
  // Also check for variations with numbers/symbols
  const normalized = text.toLowerCase().replace(/[0-9@$]/g, (c) => {
    const map = {'0':'o','1':'i','3':'e','4':'a','@':'a','$':'s'};
    return map[c] || c;
  });
  
  BANNED_WORDS.forEach(slur => {
    if (normalized.includes(slur.toLowerCase())) {
      filtered = '****';
    }
  });
  
  return filtered;
}

function isValidUsername(name) {
  if (!name || name.trim().length === 0) return false;
  const filtered = filterText(name);
  // Check if the name contains filtered slurs
  if (filtered.includes('****') || filtered !== name) return false;
  // Must be 1-16 characters
  if (name.length > 16 || name.length < 1) return false;
  // Only allow alphanumeric and basic symbols
  if (!/^[a-zA-Z0-9 _\-\[\]().!@#$%^&*+=]{1,16}$/.test(name)) return false;
  return true;
}

// ============ BAN SYSTEM ============
let bannedUsers = new Set();

function banUser(userId, reason = 'No reason given') {
  if (!isDev) {
    addNotification('❌ Only devs can ban users', [], 3000);
    return;
  }
  bannedUsers.add(userId);
  addNotification(`🚫 Banned user: ${userId}`, [], 4000);
  devLog(`Banned ${userId}. Reason: ${reason}`);
  
  if (partyChannel) {
    partyChannel.postMessage({
      type: 'ban',
      room: roomId,
      sender: myPlayerId,
      target: userId,
      reason: reason
    });
  }
  
  updateBanListDisplay();
}

function unbanUser(userId) {
  if (!isDev) {
    addNotification('❌ Only devs can unban users', [], 3000);
    return;
  }
  bannedUsers.delete(userId);
  addNotification(`✅ Unbanned user: ${userId}`, [], 3000);
  devLog(`Unbanned ${userId}`);
  
  if (partyChannel) {
    partyChannel.postMessage({
      type: 'unban',
      room: roomId,
      sender: myPlayerId,
      target: userId
    });
  }
  
  updateBanListDisplay();
}

function isUserBanned(userId) {
  return bannedUsers.has(userId);
}

function updateBanListDisplay() {
  const display = document.getElementById('banListDisplay');
  if (!display) return;
  if (bannedUsers.size === 0) {
    display.value = 'No banned users';
  } else {
    display.value = Array.from(bannedUsers).join('\n');
  }
}

// ============ ENGINE ============
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const W = canvas.width, H = canvas.height;

let gameState = 'menu';
let stocks = { p1: 3, p2: 3 };
let screenShake = 0;
let particles = [];
let player1, player2;
let isHost = false, isInParty = false;
let roomId = null;
let partyChannel = null;
let myPlayerId = Math.random().toString(36).substr(2,9);
let myFriendCode = myPlayerId.substring(0, 8).toUpperCase();
let myPlayerName = 'You';
let remotePlayers = new Map();
let aiEnabled = true;
let p1Sprite = null;
let friendsList = [];
let onlineFriends = new Set();
let serverPlayers = new Map();
let isDev = false;
let devUsers = new Set();
let timeStopped = false;
let timeStopTimer = 0;
let timeStopCooldown = 0;
let selectedChar = 'default';
const AUTO_KO_PERCENT = 300; // Auto KO at 300%

// ============ DEV SYSTEM ============
const DEV_PASSWORD = 'zawardo';

const DEV_COMMANDS = {
  help: 'Show this help',
  dev: 'Authenticate: /dev <password>',
  givedev: 'Give dev: /givedev <playerId>',
  revokedev: 'Revoke dev: /revokedev <playerId>',
  heal: 'Heal yourself',
  kill: 'KO opponent',
  noclip: 'Toggle noclip',
  timestop: 'Force time stop',
  setdamage: 'Set damage: /setdamage <value>',
  setstocks: 'Set stocks: /setstocks <p1/p2> <value>',
  spawnai: 'Spawn AI opponent',
  kick: 'Kick player: /kick <playerId>',
  ban: 'Ban user: /ban <playerId> [reason]',
  unban: 'Unban user: /unban <playerId>',
  broadcast: 'Send message: /broadcast <message>',
  listdevs: 'List all dev users',
  listplayers: 'List room players',
  listbanned: 'List banned users',
  clearchat: 'Clear console',
  whoami: 'Show your info',
  addword: 'Add banned word: /addword <word>',
  removeword: 'Remove banned word: /removeword <word>',
  listwords: 'List all banned words'
};

function authenticateDev(password) {
  if (password === DEV_PASSWORD) {
    isDev = true;
    devUsers.add(myPlayerId);
    document.getElementById('devBtn').style.display = 'inline-block';
    addNotification('🔮 Dev mode activated!', [], 4000);
    devLog('✅ Authenticated as admin.');
    if (partyChannel) {
      partyChannel.postMessage({ type: 'devAuth', room: roomId, sender: myPlayerId, target: myPlayerId });
    }
    return true;
  }
  return false;
}

function toggleDevConsole() {
  if (!isDev) {
    const pw = prompt('Enter dev password:');
    if (!authenticateDev(pw)) {
      addNotification('❌ Invalid password', [], 3000);
      return;
    }
  }
  const devConsole = document.getElementById('devConsole');
  devConsole.classList.toggle('open');
  if (devConsole.classList.contains('open')) {
    document.getElementById('devInput').focus();
  }
}

function devLog(msg) {
  const output = document.getElementById('devOutput');
  output.innerHTML += `<div style="color:#0f0;">[DEV] ${msg}</div>`;
  output.scrollTop = output.scrollHeight;
}

function handleDevCommand(event) {
  if (event.key !== 'Enter') return;
  const input = document.getElementById('devInput');
  const cmd = input.value.trim();
  input.value = '';
  
  if (!cmd) return;
  devLog(`> ${cmd}`);
  
  const parts = cmd.match(/(?:[^\s"]+|"[^"]*")+/g) || [];
  const command = parts[0].toLowerCase();
  const args = parts.slice(1).map(a => a.replace(/^"|"$/g, ''));
  
  if (!isDev && command !== '/dev') {
    devLog('❌ Not authenticated. Use /dev <password>');
    return;
  }
  
  switch(command) {
    case '/help':
      devLog('📋 Commands:');
      Object.entries(DEV_COMMANDS).forEach(([cmd, desc]) => {
        devLog(`  /${cmd} - ${desc}`);
      });
      break;
      
    case '/dev':
      if (args[0]) authenticateDev(args[0]);
      else devLog('Already authenticated.');
      break;
      
    case '/givedev':
      if (args[0]) {
        devUsers.add(args[0]);
        if (partyChannel) partyChannel.postMessage({ type: 'giveDev', room: roomId, sender: myPlayerId, target: args[0] });
        devLog(`✅ Gave dev to ${args[0]}`);
      }
      break;
      
    case '/revokedev':
      if (args[0] && args[0] !== myPlayerId) {
        devUsers.delete(args[0]);
        if (partyChannel) partyChannel.postMessage({ type: 'revokeDev', room: roomId, sender: myPlayerId, target: args[0] });
        devLog(`❌ Revoked dev from ${args[0]}`);
      }
      break;
      
    case '/heal':
      if (player1) { player1.damage = 0; player1.health = player1.maxHealth; devLog('💚 Healed!'); }
      break;
      
    case '/kill':
      if (player2) { player2.onKO(player1); devLog('💀 KO!'); }
      break;
      
    case '/timestop':
      activateTimeStop(180);
      devLog('⏱️ THE WORLD!');
      break;
      
    case '/setdamage':
      if (args[0] && player2) { player2.damage = parseFloat(args[0]) || 0; devLog(`Set damage to ${args[0]}%`); }
      break;
      
    case '/setstocks':
      if (args[0] && args[1]) {
        stocks[args[0]] = parseInt(args[1]) || 3;
        devLog(`Set ${args[0]} stocks to ${args[1]}`);
      }
      break;
      
    case '/spawnai':
      if (player2 && !player2.isAI) {
        player2 = new Fighter(W-140, H-80, 'CPU', '#ff6644', true);
        aiEnabled = true;
        devLog('🤖 AI spawned');
      }
      break;
      
    case '/kick':
      if (args[0] && partyChannel) {
        partyChannel.postMessage({ type: 'kick', room: roomId, sender: myPlayerId, target: args[0] });
        devLog(`Kicked ${args[0]}`);
      }
      break;
      
    case '/ban':
      if (args[0]) {
        const reason = args.slice(1).join(' ') || 'No reason';
        banUser(args[0], reason);
      }
      break;
      
    case '/unban':
      if (args[0]) unbanUser(args[0]);
      break;
      
    case '/broadcast':
      if (args.length > 0 && partyChannel) {
        const msg = args.join(' ');
        partyChannel.postMessage({ type: 'broadcast', room: roomId, sender: myPlayerId, message: msg });
        devLog(`Broadcast: ${msg}`);
      }
      break;
      
    case '/listdevs':
      devLog('Dev users: ' + Array.from(devUsers).join(', '));
      break;
      
    case '/listplayers':
      devLog('Room players:');
      devLog(`  You: ${myPlayerId} (${myPlayerName})`);
      serverPlayers.forEach((p, id) => devLog(`  ${id}: ${p.name}`));
      break;
      
    case '/listbanned':
      devLog('Banned: ' + (bannedUsers.size ? Array.from(bannedUsers).join(', ') : 'none'));
      break;
      
    case '/addword':
      if (args[0]) {
        BANNED_WORDS.add(args[0].toLowerCase());
        devLog(`Added banned word: ${args[0]}`);
      }
      break;
      
    case '/removeword':
      if (args[0]) {
        BANNED_WORDS.delete(args[0].toLowerCase());
        devLog(`Removed banned word: ${args[0]}`);
      }
      break;
      
    case '/listwords':
      devLog('Banned words: ' + Array.from(BANNED_WORDS).join(', '));
      break;
      
    case '/whoami':
      devLog(`ID: ${myPlayerId} | Code: ${myFriendCode} | Name: ${myPlayerName} | Dev: ${isDev}`);
      break;
      
    case '/clearchat':
      document.getElementById('devOutput').innerHTML = '';
      break;
      
    default:
      devLog(`Unknown: ${command}. /help for list`);
  }
}

function activateTimeStop(duration = 120) {
