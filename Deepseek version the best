<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>⚔️ Combo Clash: Ultimate Y2K Edition</title>
  <style>
    :root {
      --bg: #0a0a1a;
      --panel-bg: rgba(5,5,25,0.96);
      --gold: #ffd700;
      --dev: #ff00ff;
    }
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background: var(--bg);
      font-family: 'Segoe UI', 'Courier New', monospace;
      overflow: hidden;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      user-select: none;
    }
    #gameWrapper {
      position: relative;
      width: 960px;
      height: 540px;
    }
    canvas {
      display: block;
      border-radius: 12px;
      box-shadow: 0 0 40px rgba(0, 255, 255, 0.3);
    }
    
    /* Top Bar */
    #topBar {
      position: absolute;
      top: 8px;
      left: 8px;
      right: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 15;
    }
    .room-badge {
      background: rgba(0,0,0,0.8);
      color: #00ffcc;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: bold;
      border: 1px solid #00ffcc66;
      display: none;
      align-items: center;
      gap: 8px;
      backdrop-filter: blur(5px);
    }
    .room-badge.visible { display: flex; }
    .btn-sm {
      background: transparent;
      border: 1px solid #00ffcc;
      color: #00ffcc;
      padding: 4px 10px;
      border-radius: 12px;
      cursor: pointer;
      font-size: 11px;
      font-weight: bold;
      transition: 0.2s;
      white-space: nowrap;
    }
    .btn-sm:hover { background: #00ffcc33; box-shadow: 0 0 10px #00ffcc66; }
    .btn-sm.danger { border-color: #ff4444; color: #ff4444; }
    .btn-sm.danger:hover { background: #ff444433; }
    .btn-sm.warn { border-color: #ffaa00; color: #ffaa00; }
    .btn-sm.purple { border-color: #cc88ff; color: #cc88ff; }
    .top-btns { display: flex; gap: 6px; }
    
    /* Notifications */
    #notificationContainer {
      position: absolute;
      top: 50px;
      right: 10px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 25;
    }
    .notification {
      background: rgba(10,10,40,0.95);
      border: 2px solid #ffaa00;
      color: #fff;
      padding: 10px 16px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: bold;
      animation: slideIn 0.3s ease;
      display: flex;
      align-items: center;
      gap: 10px;
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 20px rgba(0,0,0,0.6);
      min-width: 250px;
    }
    .notification button {
      background: #ffaa00;
      border: none;
      color: #000;
      padding: 6px 14px;
      border-radius: 15px;
      cursor: pointer;
      font-weight: bold;
      font-size: 11px;
      white-space: nowrap;
    }
    .notification button.decline { background: #555; color: #fff; }
    @keyframes slideIn {
      from { opacity: 0; transform: translateX(50px); }
      to { opacity: 1; transform: translateX(0); }
    }
    
    /* Kill Feed */
    #killFeed {
      position: absolute;
      right: 10px;
      top: 50px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      pointer-events: none;
      z-index: 14;
    }
    .kill-msg {
      background: rgba(0,0,0,0.85);
      color: #ffcc00;
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: bold;
      animation: kfIn 0.3s ease, kfOut 0.5s 2.5s forwards;
      border-left: 4px solid #ff4444;
    }
    @keyframes kfIn { from { opacity:0; transform:translateX(30px); } to { opacity:1; transform:translateX(0); } }
    @keyframes kfOut { to { opacity:0; transform:translateX(-30px); } }
    
    /* Panels */
    .side-panel {
      position: absolute;
      top: 50px;
      background: var(--panel-bg);
      border: 1px solid #4488ff;
      border-radius: 12px;
      padding: 12px;
      z-index: 20;
      display: none;
      backdrop-filter: blur(10px);
      min-width: 220px;
      max-height: 400px;
      overflow-y: auto;
      color: #fff;
    }
    .side-panel.open { display: block; }
    .side-panel.left { left: 10px; }
    .side-panel.right { right: 10px; }
    .side-panel h4 {
      color: #88bbff;
      margin-bottom: 8px;
      font-size: 14px;
      border-bottom: 1px solid #333;
      padding-bottom: 5px;
    }
    .side-panel input, .side-panel select {
      background: #222;
      border: 1px solid #555;
      color: #fff;
      padding: 5px 8px;
      border-radius: 8px;
      font-size: 11px;
      width: 100%;
      margin: 3px 0;
    }
    
    /* Player list entries */
    .player-entry {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 5px 8px;
      border-radius: 6px;
      margin: 3px 0;
      font-size: 12px;
      background: #ffffff08;
    }
    .player-entry .actions {
      display: flex;
      gap: 4px;
    }
    .btn-micro {
      background: #333;
      border: 1px solid #555;
      color: #ccc;
      padding: 2px 8px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 10px;
    }
    .btn-micro.ban { border-color: #ff4444; color: #ff4444; }
    .btn-micro.unban { border-color: #44ff44; color: #44ff44; }
    .btn-micro.friend { border-color: #4488ff; color: #88bbff; }
    
    /* Status dots */
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      margin-right: 6px;
    }
    .status-dot.online { background: #00ff44; box-shadow: 0 0 6px #00ff44; }
    .status-dot.offline { background: #666; }
    .status-dot.dev { background: #ff00ff; box-shadow: 0 0 10px #ff00ff; animation: pulse 0.5s infinite; }
    .status-dot.banned { background: #ff0000; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.5} }
    
    /* Dev console */
    #devConsole {
      position: absolute;
      bottom: 10px;
      left: 10px;
      right: 10px;
      background: rgba(0,0,0,0.9);
      border: 1px solid #ff00ff;
      border-radius: 8px;
      z-index: 30;
      display: none;
      padding: 8px;
      color: #0f0;
      font-family: 'Courier New', monospace;
      font-size: 12px;
    }
    #devConsole.open { display: block; }
    #devConsole input {
      background: #000;
      border: 1px solid #0f0;
      color: #0f0;
      padding: 5px;
      width: 100%;
      font-family: monospace;
      font-size: 12px;
    }
    #devOutput {
      max-height: 100px;
      overflow-y: auto;
      margin-bottom: 5px;
    }
    
    /* Menu Overlays */
    .menu-overlay {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: rgba(5,5,20,0.93);
      z-index: 30;
      pointer-events: all;
    }
    .menu-overlay.hidden { display: none; }
    .menu-btn {
      background: linear-gradient(135deg, #ff4d7a, #cc2255);
      border: 2px solid #ff88aa;
      color: white;
      padding: 14px 40px;
      margin: 8px;
      border-radius: 30px;
      font-size: 1.1rem;
      font-weight: bold;
      cursor: pointer;
      transition: 0.2s;
      text-transform: uppercase;
      letter-spacing: 2px;
      min-width: 220px;
    }
    .menu-btn:hover { transform: scale(1.08); box-shadow: 0 0 25px #ff4d7a; }
    .menu-btn.secondary { background: linear-gradient(135deg, #4488ff, #2255cc); border-color: #88bbff; }
    .menu-btn.gold { background: linear-gradient(135deg, #ffd700, #b8960f); border-color: #ffed4a; color: #000; }
    .menu-title {
      font-size: 3rem;
      color: #fff;
      text-shadow: 0 0 30px cyan, 0 0 60px #ff4d7a;
      margin-bottom: 25px;
      letter-spacing: 4px;
    }
    
    /* Settings */
    .settings-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      color: #fff;
      font-size: 13px;
    }
    .settings-grid label {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .settings-grid input, .settings-grid select {
      background: #1a1a3a;
      border: 1px solid #555;
      color: #fff;
      padding: 6px 10px;
      border-radius: 8px;
    }
    
    /* Damage numbers */
    .damage-text {
      position: absolute;
      font-weight: bold;
      font-size: 22px;
      color: #ff4444;
      pointer-events: none;
      animation: dmgFloat 1s forwards;
      text-shadow: 0 0 8px black;
    }
    @keyframes dmgFloat {
      0% { opacity:1; transform:translateY(0); }
      100% { opacity:0; transform:translateY(-60px); }
    }
    
    /* Time stop effect */
    .time-stop-overlay {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: radial-gradient(ellipse, rgba(100,0,255,0.3) 0%, rgba(0,0,0,0.6) 100%);
      pointer-events: none;
      z-index: 5;
      display: none;
    }
    .time-stop-overlay.active {
      display: block;
      animation: timePulse 0.5s ease-in-out;
    }
    @keyframes timePulse {
      0% { background: radial-gradient(ellipse, rgba(255,0,255,0.6) 0%, rgba(0,0,0,0.8) 100%); }
      100% { background: radial-gradient(ellipse, rgba(100,0,255,0.3) 0%, rgba(0,0,0,0.6) 100%); }
    }
    
    .friend-code-display {
      background: #1a1a3a;
      padding: 8px;
      border-radius: 8px;
      text-align: center;
      font-family: monospace;
      font-size: 14px;
      color: #ffcc00;
      border: 1px dashed #ffcc00;
      margin: 5px 0;
    }
  </style>
</head>
<body>
<div id="gameWrapper">
  <canvas id="gameCanvas" width="960" height="540"></canvas>
  
  <!-- Time Stop Overlay -->
  <div class="time-stop-overlay" id="timeStopOverlay"></div>
  
  <!-- Top Bar -->
  <div id="topBar">
    <div class="room-badge" id="roomBadge">
      <span id="roomCodeDisplay">🏠 ----</span>
      <button class="btn-sm" onclick="copyRoomCode()">📋</button>
      <button class="btn-sm warn" onclick="shareRoomLink()">🔗</button>
      <button class="btn-sm danger" onclick="leaveRoom()">🚪</button>
    </div>
    <div class="top-btns">
      <button class="btn-sm purple" onclick="togglePanel('serverPlayersPanel')">👥 Players</button>
      <button class="btn-sm" onclick="togglePanel('friendsPanel')" style="border-color:#88bbff;color:#88bbff;">👥 Friends</button>
      <button class="btn-sm" onclick="togglePanel('settingsPanel')" style="border-color:#aaa;color:#ccc;">⚙️</button>
