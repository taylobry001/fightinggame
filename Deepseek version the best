// ============ NOTIFICATIONS ============
function addNotification(message, actions = [], duration = 8000) {
  const container = document.getElementById('notificationContainer');
  const notif = document.createElement('div');
  notif.className = 'notification';
  notif.innerHTML = `<span>${message}</span>`;
  
  const btnContainer = document.createElement('div');
  btnContainer.style.display = 'flex';
  btnContainer.style.gap = '5px';
  
  actions.forEach(action => {
    const btn = document.createElement('button');
    btn.textContent = action.text;
    btn.className = action.decline ? 'decline' : '';
    btn.onclick = () => { action.callback(); notif.remove(); };
    btnContainer.appendChild(btn);
  });
  
  notif.appendChild(btnContainer);
  container.appendChild(notif);
  
  if (duration > 0) {
    setTimeout(() => { if (notif.parentNode) notif.remove(); }, duration);
  }
  
  return notif;
}

// ============ PANELS ============
function togglePanel(panelId) {
  const panel = document.getElementById(panelId);
  if (!panel) return;
  
  // Close other panels
  document.querySelectorAll('.side-panel').forEach(p => {
    if (p.id !== panelId) p.classList.remove('open');
  });
  
  panel.classList.toggle('open');
  
  // Update content when opening
  if (panel.classList.contains('open')) {
    if (panelId === 'serverPlayersPanel') updateServerPlayersList();
    if (panelId === 'friendsPanel') updateFriendsList();
  }
}

function updateServerPlayersList() {
  const container = document.getElementById('serverPlayersList');
  if (!container) return;
  
  if (!isInParty) {
    container.innerHTML = '<div style="color:#888;font-size:11px;">Not in a room</div>';
    return;
  }
  
  let html = `<div class="player-entry" style="background:#ffffff15;">
    <span><span class="status-dot ${isDev?'dev':'online'}"></span>${myPlayerName} (You)${isDev?' 🔮':''}</span>
    <span style="color:#888;font-size:10px;">${myFriendCode}</span>
  </div>`;
  
  serverPlayers.forEach((p, id) => {
    const isBanned = isUserBanned(id);
    const isDevUser = devUsers.has(id);
    html += `<div class="player-entry" style="${isBanned?'background:#ff000022;':''}">
      <span>
        <span class="status-dot ${isBanned?'banned':isDevUser?'dev':'online'}"></span>
        ${p.name}${isDevUser?' 🔮':''}${isBanned?' 🚫':''}
      </span>
      <div class="actions">
        ${!friendsList.find(f=>f.id===id) ? `<button class="btn-micro friend" onclick="addFriendById('${id}')">+Friend</button>` : ''}
        ${isDev ? (isBanned ? 
          `<button class="btn-micro unban" onclick="unbanUser('${id}')">Unban</button>` :
          `<button class="btn-micro ban" onclick="banUser('${id}')">Ban</button>`
        ) : ''}
      </div>
    </div>`;
  });
  
  if (serverPlayers.size === 0) {
    html += '<div style="color:#888;font-size:11px;">No other players</div>';
  }
  
  container.innerHTML = html;
}

// ============ ROOM MANAGEMENT ============
function copyRoomCode() {
  if (!roomId) return;
  navigator.clipboard.writeText(roomId).then(() => {
    addNotification('📋 Copied!', [], 2000);
  });
}

function shareRoomLink() {
  if (!roomId) return;
  const link = `${window.location.origin}${window.location.pathname}?room=${roomId}`;
  navigator.clipboard.writeText(link).then(() => {
    addNotification('🔗 Link copied!', [], 2000);
  });
}

function leaveRoom() {
  if (partyChannel) {
    partyChannel.postMessage({ type: 'leave', room: roomId, sender: myPlayerId });
    partyChannel.close();
  }
  partyChannel = null;
  isInParty = false;
  roomId = null;
  isHost = false;
  aiEnabled = true;
  remotePlayers.clear();
  serverPlayers.clear();
  document.getElementById('roomBadge').classList.remove('visible');
  if (player2) player2 = new Fighter(W-140, H-80, 'CPU Fighter', '#ff6644', true);
  addNotification('🚪 Left room', [], 3000);
}

function joinRoom(code) {
  if (partyChannel) partyChannel.close();
  roomId = code;
  partyChannel = new BroadcastChannel('combo-clash-v4');
  partyChannel.onmessage = handleNetworkMessage;
  isHost = false;
  isInParty = true;
  aiEnabled = false;
  
  document.getElementById('roomBadge').classList.add('visible');
  document.getElementById('roomCodeDisplay').textContent = '🏠 ' + roomId;
  
  if (player2) { player2.isAI = false; player2.name = 'Waiting...'; }
  
  gameState = 'playing';
  partyChannel.postMessage({ type: 'presence', room: roomId, sender: myPlayerId, senderName: myPlayerName, friendCode: myFriendCode });
  addNotification('🔗 Joined: ' + roomId, [], 3000);
  updateServerPlayersList();
}

// ============ FRIENDS ============
function generateFriendCode() {
  myFriendCode = myPlayerId.substring(0, 8).toUpperCase();
  document.getElementById('myFriendCode').textContent = myFriendCode;
  const fsCode = document.getElementById('fsFriendCode');
  if (fsCode) fsCode.textContent = myFriendCode;
}

function addFriend() {
  const input = document.getElementById('addFriendInput');
  const code = input.value.trim().toUpperCase();
  if (!code || code === myFriendCode) return;
  
  if (friendsList.find(f => f.code === code)) {
    addNotification('⚠️ Already added!', [], 2000);
    return;
  }
  
  friendsList.push({ id: code, code: code, name: 'Friend_' + code.substring(0,4) });
  input.value = '';
  updateFriendsList();
  addNotification('✅ Friend added!', [], 2000);
}

function addFriendById(id) {
  if (!id || id === myPlayerId) return;
  if (friendsList.find(f => f.id === id)) {
    addNotification('⚠️ Already a friend!', [], 2000);
    return;
  }
  
  const player = serverPlayers.get(id);
  friendsList.push({ id: id, code: id.substring(0,8).toUpperCase(), name: player?.name || 'Player' });
  updateFriendsList();
  updateServerPlayersList();
  addNotification('✅ Friend added!', [], 2000);
}

function inviteFriend(code) {
  if (!isInParty || !roomId) {
    addNotification('⚠️ Join a room first!', [], 2000);
    return;
  }
  
  if (partyChannel) {
    partyChannel.postMessage({
      type: 'roomInvite', room: roomId, sender: myPlayerId,
      senderName: myPlayerName, targetFriend: code, inviteRoom: roomId
    });
    addNotification('📨 Invite sent!', [], 2000);
  }
}

function updateFriendsList() {
  const container = document.getElementById('friendsListContainer');
  if (!container) return;
  
  if (friendsList.length === 0) {
    container.innerHTML = '<div style="color:#888;font-size:11px;">No friends added</div>';
    return;
  }
  
  container.innerHTML = friendsList.map(f => {
    const isOnline = onlineFriends.has(f.id);
    const isDevUser = devUsers.has(f.id);
    const isBanned = isUserBanned(f.id);
    return `
      <div class="player-entry">
        <span class="status-dot ${isBanned?'banned':isDevUser?'dev':isOnline?'online':'offline'}"></span>
        <span style="flex:1;margin-left:8px;">${f.name} <span style="color:#888;font-size:9px;">(${f.code})</span></span>
        ${isOnline ? `<button onclick="inviteFriend('${f.id}')" class="btn-micro friend">Invite</button>` : '<span style="color:#666;font-size:10px;">offline</span>'}
      </div>
    `;
  }).join('');
}

// ============ NETWORK ============
function broadcastAttack(targetId, attackType) {
  if (!partyChannel || !roomId) return;
  partyChannel.postMessage({
    type: 'attack', room: roomId, sender: myPlayerId,
    targetId, attackType, x: player1.x + player1.width/2, damage: player1.damage
  });
}

function broadcastAbility(targetId) {
  if (!partyChannel || !roomId) return;
  partyChannel.postMessage({
    type: 'ability', room: roomId, sender: myPlayerId, targetId,
    x: player1.x + player1.width/2, damage: player1.damage
  });
}

function handleNetworkMessage(event) {
  const data = event.data;
  if (!data || data.room !== roomId) return;
  
  // Check banned
  if (isUserBanned(data.sender) && data.sender !== myPlayerId) return;
  
  // Handle kicks
  if (data.type === 'kick' && data.target === myPlayerId) {
    addNotification('🚫 Kicked from room', [], 5000);
    leaveRoom();
    return;
  }
  
  // Handle bans
  if (data.type === 'ban' && data.target === myPlayerId) {
    addNotification('🚫 You have been banned!', [], 6000);
    leaveRoom();
    return;
  }
  
  if (data.type === 'ban' && isDev) {
    banUser(data.target, data.reason || 'No reason');
  }
  
  if (data.type === 'unban' && isDev) {
    unbanUser(data.target);
  }
  
  // Handle dev auth
  if (data.type === 'giveDev' && data.target === myPlayerId) {
    isDev = true;
    devUsers.add(myPlayerId);
    document.getElementById('devBtn').style.display = 'inline-block';
    addNotification('🔮 Dev powers granted!', [], 4000);
  }
  
  if (data.type === 'revokeDev' && data.target === myPlayerId) {
    isDev = false;
    devUsers.delete(myPlayerId);
    addNotification('❌ Dev powers revoked', [], 3000);
  }
  
  // Time stop
  if (data.type === 'timeStop') {
    activateTimeStop(data.duration || 120);
  }
  
  // Broadcast
  if (data.type === 'broadcast') {
    addNotification(`📢 ${data.message}`, [], 5000);
  }
  
  // Room invites
  if (data.type === 'roomInvite' && data.targetFriend === myFriendCode) {
    addNotification(
      `📨 ${data.senderName} invited you to ${data.inviteRoom}`,
      [
        { text: '✅ Join', callback: () => joinRoom(data.inviteRoom) },
        { text: '❌ Decline', callback: () => {}, decline: true }
      ],
      15000
    );
    return;
  }
  
  if (data.sender === myPlayerId) return;
  
  // Presence / State
  if (data.type === 'presence' || data.type === 'state') {
    if (!serverPlayers.has(data.sender)) {
      serverPlayers.set(data.sender, { name: data.senderName || 'Unknown', friendCode: data.friendCode || '' });
      updateServerPlayersList();
    }
    if (friendsList.find(f => f.id === data.sender)) {
      onlineFriends.add(data.sender);
    }
    if (data.type === 'presence') {
      const player = serverPlayers.get(data.sender);
      if (player) {
        player.name = data.senderName || player.name;
        player.friendCode = data.friendCode || player.friendCode;
      }
    }
  }
  
  if (data.type === 'state') {
    let remote = remotePlayers.get(data.sender);
    if (!remote) {
      remote = { id: data.sender, name: data.senderName };
      remotePlayers.set(data.sender, remote);
      if (player2.isAI) {
        player2.isAI = false;
        player2.id = data.sender;
        player2.name = data.senderName || 'Opponent';
        player2.color = '#ff6644';
        aiEnabled = false;
        addNotification(`👤 ${player2.name} joined!`, [], 3000);
      }
    }
    player2.x += (data.x - player2.x) * 0.4;
    player2.y += (data.y - player2.y) * 0.4;
    player2.damage = data.damage;
    player2.health = data.health;
    stocks.p2 = data.stocks || stocks.p2;
  }
  
  if (data.type === 'attack' && data.targetId === myPlayerId) {
    const dmg = data.attackType === 'smash' ? 18 : data.attackType === 'kick' ? 12 : 8;
    player1.takeDamage({x: data.x, damage: data.damage || 0}, dmg, data.attackType === 'smash' ? 2.5 : 1.0);
  }
  
  if (data.type === 'ability' && data.targetId === myPlayerId) {
    player1.takeDamage({x: data.x, damage: data.damage || 0}, 25, 3.0);
  }
  
  if (data.type === 'dioAbility' && data.targetId === myPlayerId) {
    activateTimeStop(150);
    player1.takeDamage({x: player2.x, damage: 50}, 20, 2.0);
  }
  
  if (data.type === 'leave') {
    serverPlayers.delete(data.sender);
    remotePlayers.delete(data.sender);
    updateServerPlayersList();
    if (player2.id === data.sender) {
      player2 = new Fighter(W-140, H-80, 'CPU Fighter', '#ff6644', true);
      aiEnabled = true;
    }
  }
}

// ============ CONTROLS ============
const keys = {};
document.addEventListener('keydown', e => {
  keys[e.key.toLowerCase()] = true;
  if (e.key === '`' && isDev) { toggleDevConsole(); e.preventDefault(); }
  if (e.key.toLowerCase() === 't' && player1?.isDIO && player1.abilityCooldown <= 0) {
    player1.useAbility(player2);
    e.preventDefault();
  }
  e.preventDefault();
});
document.addEventListener('keyup', e => {
  keys[e.key.toLowerCase()] = false;
  e.preventDefault();
});

function handleInput() {
  if (gameState !== 'playing') return;
  if (player1.stunTimer > 0) return;
  if (timeStopped && !player1.isDIO) return;
  
  if (keys['a'] || keys['arrowleft']) { player1.x -= player1.speed; player1.facingRight = false; }
  if (keys['d'] || keys['arrowright']) { player1.x += player1.speed; player1.facingRight = true; }
  if ((keys['w'] || keys['arrowup']) && player1.grounded) { player1.vy = -10; player1.grounded = false; }
  if (keys['j'] || keys['z']) player1.attack(player2, 'punch');
  if (keys['k'] || keys['x']) player1.attack(player2, 'kick');
  if (keys['l'] || keys['c']) player1.attack(player2, 'smash');
  if (keys['u'] || keys['v']) player1.useAbility(player2);
  if (isDev && keys['n']) { player1.noclip = !player1.noclip; keys['n'] = false; }
}

// ============ AI ============
function updateAI(ai, player, difficulty) {
  if (timeStopped) return;
  if (ai.stunTimer > 0) return;
  
  const diff = difficulty || 3;
  const idealDistance = 55 + Math.random() * 45;
  const dx = player.x + player.width/2 - (ai.x + ai.width/2);
  const dist = Math.abs(dx);
  
  if (dist > idealDistance + 20) {
    ai.x += Math.sign(dx) * ai.speed * (0.6 + diff * 0.1);
    ai.facingRight = dx > 0;
  } else if (dist < idealDistance - 10) {
    ai.x -= Math.sign(dx) * ai.speed * (0.5 + diff * 0.1);
  }
  
  if (Math.random() < 0.02) ai.x += (Math.random() - 0.5) * 30;
  if (ai.grounded && Math.random() < 0.01 * diff) { ai.vy = -8 - diff; ai.grounded = false; }
  
  if (dist < 65 && ai.attackTimer <= 0 && ai.stunTimer <= 0) {
    const rand = Math.random();
    if (rand < 0.04 * diff) ai.attack(player, 'punch');
    else if (rand < 0.06 * diff) ai.attack(player, 'kick');
    else if (rand < 0.08 * diff && player.damage > 40) ai.attack(player, 'smash');
  }
  
  if (dist < 80 && ai.abilityCooldown <= 0 && player.damage > 60 && Math.random() < 0.02 * diff) {
    ai.useAbility(player);
  }
}

// ============ GAME LOOP ============
function update() {
  if (gameState !== 'playing') return;
  
  if (timeStopped) {
    timeStopTimer--;
    if (timeStopTimer <= 0) {
      timeStopped = false;
      document.getElementById('timeStopOverlay').classList.remove('active');
    }
  }
  if (timeStopCooldown > 0) timeStopCooldown--;
  
  handleInput();
  player1.update();
  
  if (aiEnabled && player2.isAI) {
    updateAI(player2, player1, parseInt(document.getElementById('aiDiff')?.value || 3));
  }
  player2.update();
  
  particles = particles.filter(p => p.life > 0);
  particles.forEach(p => p.update());
  
  if (screenShake > 0) screenShake *= 0.85;
  
  if (isInParty && partyChannel && gameState === 'playing') {
    partyChannel.postMessage({
      type: 'state', room: roomId, sender: myPlayerId, senderName: myPlayerName,
      x: player1.x, y: player1.y, damage: player1.damage,
      health: player1.health, vx: player1.vx, vy: player1.vy,
      facingRight: player1.facingRight, stocks: stocks.p1, friendCode: myFriendCode
    });
  }
}

function draw() {
  ctx.clearRect(0, 0, W, H);
  
  ctx.save();
  if (screenShake > 0.5) {
    ctx.translate(
      (Math.random() - 0.5) * screenShake * 2,
      (Math.random() - 0.5) * screenShake * 2
    );
  }
  
  const gradient = ctx.createLinearGradient(0, 0, 0, H);
  gradient.addColorStop(0, '#0a0a2e');
  gradient.addColorStop(1, '#1a1a3e');
  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, W, H);
  
  ctx.fillStyle = '#2a2a4a';
  ctx.fillRect(0, H-12, W, 12);
  ctx.fillStyle = '#4a4a6a';
  ctx.fillRect(0, H-10, W, 3);
  
  ctx.strokeStyle = '#ffffff08';
  for(let i=0; i<W; i+=48) {
    ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, H); ctx.stroke();
  }
  
  if (player1) player1.draw(ctx);
  if (player2) player2.draw(ctx);
  particles.forEach(p => p.draw(ctx));
  
  if (timeStopped) {
    ctx.fillStyle = '#ff00ff11';
    for(let i=0; i<20; i++) ctx.fillRect(Math.random()*W, Math.random()*H, 2, 2);
  }
  
  ctx.restore();
  
  if (isDev) {
    ctx.fillStyle = '#ff00ffaa';
    ctx.font = '10px monospace';
    ctx.fillText('🔮 DEV', W-70, 20);
  }
}

function gameLoop() {
  update();
  draw();
  requestAnimationFrame(gameLoop);
}

// ============ MENU ============
function startGame(mode) {
  document.getElementById('mainMenu').classList.add('hidden');
  document.getElementById('fullSettingsMenu').classList.add('hidden');
  
  stocks.p1 = parseInt(document.getElementById('stockCount')?.value || 3);
  stocks.p2 = stocks.p1;
  
  // FIXED: Apply name from settings
  const nameInput = document.getElementById('playerNameInput');
  const fsNameInput = document.getElementById('fsPlayerName');
  let newName = nameInput?.value || fsNameInput?.value || 'You';
  if (!isValidUsername(newName)) newName = 'Player';
  myPlayerName = newName;
  if (nameInput) nameInput.value = myPlayerName;
  if (fsNameInput) fsNameInput.value = myPlayerName;
  
  if (selectedChar === 'dio') {
    player1 = createDIOCharacter(100, H-80);
  } else {
    player1 = new Fighter(100, H-80, myPlayerName, '#44aaff', false, myPlayerId);
  }
  player1.sprite = p1Sprite;
  player2 = new Fighter(W-140, H-80, 'CPU Fighter', '#ff6644', true);
  
  if (mode === 'local') {
    aiEnabled = true;
    player2.isAI = true;
    isInParty = false;
    document.getElementById('roomBadge').classList.remove('visible');
    gameState = 'playing';
  } else if (mode === 'host') {
    roomId = Math.random().toString(36).substring(2, 8).toUpperCase();
    partyChannel = new BroadcastChannel('combo-clash-v4');
    partyChannel.onmessage = handleNetworkMessage;
    isHost = true;
    isInParty = true;
    aiEnabled = false;
    player2.isAI = false;
    player2.name = 'Waiting...';
    document.getElementById('roomBadge').classList.add('visible');
    document.getElementById('roomCodeDisplay').textContent = '🌟 ' + roomId;
    gameState = 'playing';
    addNotification('🌟 Room: ' + roomId, [], 5000);
  } else if (mode === 'join') {
    const code = prompt('Room code:')?.trim().toUpperCase();
    if (code) joinRoom(code);
    else backToMenu();
  }
}

function showFullSettings() {
  document.getElementById('mainMenu').classList.add('hidden');
  document.getElementById('fullSettingsMenu').classList.remove('hidden');
  document.getElementById('fsStockCount').value = document.getElementById('stockCount').value;
  document.getElementById('fsAiDiff').value = document.getElementById('aiDiff').value;
  document.getElementById('fsPlayerName').value = myPlayerName;
  document.getElementById('fsFriendCode').textContent = myFriendCode;
  updateBanListDisplay();
}

function applySettings() {
  const nameInput = document.getElementById('playerNameInput');
  const fsNameInput = document.getElementById('fsPlayerName');
  const stockInput = document.getElementById('stockCount');
  const fsStockInput = document.getElementById('fsStockCount');
  
  let newName = nameInput?.value || fsNameInput?.value || 'You';
  
  // Filter the name
  if (!isValidUsername(newName)) {
    addNotification('⚠️ Name contains inappropriate content', [], 3000);
    newName = 'Player';
  }
  
  myPlayerName = newName;
  if (nameInput) nameInput.value = myPlayerName;
  if (fsNameInput) fsNameInput.value = myPlayerName;
  if (player1) player1.name = myPlayerName;
  
  // Sync stocks
  const newStocks = parseInt(stockInput?.value || fsStockInput?.value || 3);
  if (stockInput) stockInput.value = newStocks;
  if (fsStockInput) fsStockInput.value = newStocks;
  stocks.p1 = newStocks;
  stocks.p2 = newStocks;
  
  addNotification('✅ Settings applied!', [], 2000);
}

function backToMenu() {
  gameState = 'menu';
  document.getElementById('mainMenu').classList.remove('hidden');
  document.getElementById('fullSettingsMenu').classList.add('hidden');
  document.getElementById('roomBadge').classList.remove('visible');
  document.getElementById('devConsole').classList.remove('open');
  if (partyChannel) partyChannel.close();
  partyChannel = null;
  isInParty = false;
  roomId = null;
  aiEnabled = true;
  remotePlayers.clear();
  serverPlayers.clear();
  particles = [];
  document.getElementById('killFeed').innerHTML = '';
  timeStopped = false;
  document.getElementById('timeStopOverlay').classList.remove('active');
}

// Sprite upload
document.getElementById('p1SpriteInput')?.addEventListener('change', function(e) {
  const file = e.target.files[0];
  if (file) {
    const reader = new FileReader();
    reader.onload = function(ev) {
      const img = new Image();
      img.onload = function() { p1Sprite = img; if (player1) player1.sprite = img; };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  }
});

