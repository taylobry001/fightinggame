<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>🎮 Combo Clash: Y2K Party • Multiplayer</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background: #0a0f1e;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Segoe UI', 'Courier New', monospace;
      overflow-y: auto;
      padding: 20px;
    }
    .game-container {
      background: linear-gradient(145deg, #1a1f2f, #0b0e17);
      border-radius: 32px;
      padding: 20px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.7), 0 0 30px #00ffff66;
      border: 1px solid #4e5a7a;
    }
    canvas {
      display: block;
      margin: 0 auto;
      border-radius: 20px;
      box-shadow: inset 0 0 30px #00000080, 0 10px 25px black;
      background: #111;
      width: 100%;
      height: auto;
      max-width: 900px;
    }
    .control-panel {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin-top: 18px;
      background: rgba(20, 25, 45, 0.8);
      backdrop-filter: blur(15px);
      padding: 15px 25px;
      border-radius: 60px;
      border: 1px solid #5f6b9b;
      color: #e0f0ff;
    }
    .player-badge {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #0000004d;
      padding: 5px 15px;
      border-radius: 30px;
    }
    select, input, button {
      background: #232a3c;
      border: 1px solid #6d7db0;
      color: white;
      padding: 10px 16px;
      border-radius: 30px;
      font-weight: bold;
      font-size: 0.9rem;
      cursor: pointer;
      backdrop-filter: blur(10px);
      transition: all 0.2s;
      box-shadow: 0 4px 8px rgba(0,0,0,0.5);
    }
    button {
      background: #ff4d7a;
      border-color: #ffb3c6;
      font-weight: bold;
      letter-spacing: 0.5px;
    }
    button:hover {
      background: #ff3366;
      transform: scale(1.03);
      border-color: white;
    }
    select:hover, input:hover {
      background: #2f3855;
    }
    .party-join {
      background: #00cc99;
      border-color: #a0ffe0;
      color: black;
    }
    .room-info {
      background: #00000055;
      padding: 6px 18px;
      border-radius: 20px;
      font-family: monospace;
      font-size: 1rem;
      border: 1px dashed #aaa;
    }
    label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.9rem;
    }
    h2 {
      color: #b7e4ff;
      text-shadow: 0 0 12px cyan;
      margin: 0 10px;
    }
  </style>
</head>
<body>
<div style="display: flex; flex-direction: column; align-items: center;">
  <div class="game-container">
    <canvas id="gameCanvas" width="900" height="450"></canvas>
    
    <div class="control-panel">
      <div class="player-badge">
        <span>👤 YOU:</span>
        <select id="charSelect">
          <option value="#00ffff">❄️ Cyan Fighter</option>
          <option value="#ff44cc">🌸 Magenta Ninja</option>
          <option value="#aaff00">🍀 Lime Warrior</option>
        </select>
      </div>
      
      <div style="display: flex; gap: 5px;">
        <button id="partyHostBtn" class="party-join">🌟 HOST PARTY</button>
        <button id="joinPartyBtn">🔗 JOIN ROOM</button>
      </div>
      
      <div class="room-info" id="roomDisplay">
        <span id="roomCodeText">🏠 No room</span>
      </div>
      
      <button id="pauseBtn">⏯️ Pause</button>
      <button id="restartBtn">🔄 Restart</button>
      
      <label>🎚️ Difficulty
        <input type="range" id="diffSlider" min="1" max="5" value="3" style="width:80px;">
      </label>
    </div>
    
    <div style="display: flex; justify-content: center; gap: 30px; margin-top: 12px; color: #cfdbff; flex-wrap: wrap;">
      <span>🕹️ <b>P1:</b> ←→ move | Z punch | X kick | C special (combo≥3)</span>
      <span>👥 <b>Party:</b> Host & join same room code</span>
    </div>
  </div>
  <div style="margin-top: 10px; color: #aaa; font-size: 0.8rem;">
    ⚡ Multiplayer via BroadcastChannel • Open two tabs or share link
  </div>
</div>

<script>
  (function() {
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    // ----- MULTIPLAYER PARTY SYSTEM (BroadcastChannel) -----
    const channelName = "combo-clash-y2k-party";
    let partyChannel = null;
    let roomId = null;          // current room code
    let isHost = false;
    let remotePlayers = new Map(); // id -> { x, y, color, health, combo }
    let myPlayerId = Math.random().toString(36).substr(2, 9);

    // DOM elements
    const charSelect = document.getElementById('charSelect');
    const diffSlider = document.getElementById('diffSlider');
    const pauseBtn = document.getElementById('pauseBtn');
    const restartBtn = document.getElementById('restartBtn');
    const partyHostBtn = document.getElementById('partyHostBtn');
    const joinPartyBtn = document.getElementById('joinPartyBtn');
    const roomCodeText = document.getElementById('roomCodeText');

    // Game state
    let playerColor = charSelect.value;
    let paused = false;
    let gameActive = true;
    let player, enemy;
    let particles = [], worldParticles = [], shootingStars = [];
    let screenShake = 0;
    let aiEnabled = true;  // AI enemy exists unless remote player takes role

    // Background modes
    const backgrounds = [
      "Glassy Sky & Bubbles","Water + Fish + Light Rays","Sunlit Ocean Waves + Aurora",
      "Grassy Horizon + Floating Particles","Shiny Chrome Grid","Vector Neon Scans",
      "Cyber Glitter","Futuristic UI Lines","Galaxy Stars & Nebula",
      "Aurora Cosmic Trails","Shooting Stars + Sparkles","Holographic Orbs",
      "Pastel Gradient Waves","Bokeh Lights","Glossy Spheres","Neon Bloom",
      "Glass + Lens Flares","Floating Glass Planets","Crystalline Water Glow","Soft Haze Glow Gradients"
    ];
    let bgMode = backgrounds[Math.floor(Math.random() * backgrounds.length)];

    // Controls
    const keys = {};
    document.addEventListener('keydown', e => { keys[e.key.toLowerCase()] = true; e.preventDefault(); });
    document.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; e.preventDefault(); });

    // Particle class
    class Particle {
      constructor(x, y, dx, dy, color, lifetime) {
        this.x = x; this.y = y; this.dx = dx; this.dy = dy; this.color = color; this.lifetime = lifetime;
      }
      update() { this.x += this.dx; this.y += this.dy; this.lifetime--; }
      draw(ctx) {
        ctx.fillStyle = this.color;
        ctx.globalAlpha = Math.min(1, this.lifetime / 40);
        ctx.fillRect(this.x, this.y, 5, 5);
        ctx.globalAlpha = 1;
      }
    }

    // Fighter base class
    class Fighter {
      constructor(x, y, color, isAI = false, id = null) {
        this.x = x; this.y = y;
        this.width = 45; this.height = 75;
        this.color = color;
        this.health = 100;
        this.maxHealth = 100;
        this.speed = 4.5;
        this.isAI = isAI;
        this.combo = 0;
        this.attackTimer = 0;
        this.id = id || Math.random().toString(36);
        this.facingRight = true;
      }

      draw(ctx, isRemote = false) {
        ctx.save();
        // Body
        ctx.fillStyle = this.color;
        ctx.shadowColor = this.color;
        ctx.shadowBlur = 12;
        ctx.fillRect(this.x, this.y, this.width, this.height);
        ctx.shadowBlur = 0;
        ctx.shadowColor = 'transparent';
        
        // Health bar
        ctx.fillStyle = '#333';
        ctx.fillRect(this.x, this.y - 14, this.width, 8);
        const healthPercent = this.health / this.maxHealth;
        ctx.fillStyle = healthPercent > 0.5 ? '#3f3' : '#ff5555';
        ctx.fillRect(this.x, this.y - 14, this.width * healthPercent, 8);
        
        // Combo display
        if (this.combo > 1) {
          ctx.fillStyle = '#ffcc00';
          ctx.font = 'bold 18px "Courier New"';
          ctx.fillText(`${this.combo} HIT!`, this.x, this.y - 22);
        }
        
        // Remote indicator
        if (isRemote) {
          ctx.fillStyle = 'white';
          ctx.font = '10px monospace';
          ctx.fillText('👤', this.x + this.width/2-8, this.y - 18);
        }
        ctx.restore();
      }

      attack(opponent, type = 'punch') {
        if (this.attackTimer > 0 || !opponent) return;
        let damage = type === 'punch' ? 6 : (type === 'kick' ? 9 : 12);
        if (Math.abs(this.x - opponent.x) < 65) {
          opponent.health = Math.max(0, opponent.health - damage);
          this.combo = Math.min(10, this.combo + 1);
          screenShake = 6;
          for (let i = 0; i < 10; i++) {
            particles.push(new Particle(
              opponent.x + 20, opponent.y + 35,
              (Math.random() - 0.5) * 5, -Math.random() * 3,
              '#ffff00', 25
            ));
          }
        }
        this.attackTimer = 22;
      }

      special(opponent) {
        if (this.attackTimer > 0 || this.combo < 3 || !opponent) return;
        if (Math.abs(this.x - opponent.x) < 100) {
          opponent.health = Math.max(0, opponent.health - 22);
          screenShake = 12;
          for (let i = 0; i < 25; i++) {
            particles.push(new Particle(
              opponent.x + 20, opponent.y + 35,
              (Math.random() - 0.5) * 7, -Math.random() * 5,
              this.color, 45
            ));
          }
        }
        this.combo = 0;
        this.attackTimer = 45;
      }

      update(opponent, difficulty = 3) {
        if (this.attackTimer > 0) this.attackTimer--;
        
        if (this.isAI && opponent) {
          let aiSpeed = this.speed * (0.7 + difficulty * 0.1);
          if (this.x < opponent.x - 15) this.x += aiSpeed;
          else if (this.x > opponent.x + 15) this.x -= aiSpeed;
          
          if (Math.abs(this.x - opponent.x) < 60 && this.attackTimer <= 0) {
            if (Math.random() < 0.04 * difficulty) this.attack(opponent, 'punch');
          }
        }
        this.x = Math.max(5, Math.min(canvas.width - this.width - 5, this.x));
      }
    }

    // Initialize fighters
    function createPlayer(color) {
      return new Fighter(120, 330, color, false, myPlayerId);
    }
    function createEnemy() {
      return new Fighter(700, 330, '#ff8844', true);
    }

    player = createPlayer(playerColor);
    enemy = createEnemy();

    // World particles
    for (let i = 0; i < 80; i++) {
      worldParticles.push({
        x: Math.random() * canvas.width, y: Math.random() * canvas.height,
        size: Math.random() * 3 + 1, dx: (Math.random() - 0.5) * 0.6,
        dy: (Math.random() - 0.5) * 0.6, color: `hsl(${Math.random() * 360}, 80%, 70%)`
      });
    }

    function spawnShootingStar() {
      shootingStars.push({
        x: Math.random() * canvas.width, y: 0,
        length: Math.random() * 90 + 40, speed: Math.random() * 7 + 4,
        angle: Math.random() * 0.4 + 0.1
      });
    }

    // Background drawing (condensed)
    function drawBackground() {
      const t = Date.now() / 1000;
      if (bgMode.includes("Galaxy") || bgMode.includes("Star")) {
        ctx.fillStyle = '#0a0a1a'; ctx.fillRect(0,0,canvas.width,canvas.height);
        for (let p of worldParticles) { ctx.fillStyle = 'white'; ctx.fillRect(p.x,p.y,p.size,p.size); }
        if(Math.random()<0.02) spawnShootingStar();
      } else if (bgMode.includes("Neon") || bgMode.includes("Vector")) {
        ctx.fillStyle = '#111'; ctx.fillRect(0,0,canvas.width,canvas.height);
        ctx.strokeStyle = `hsl(${t*80%360},100%,60%)`;
        for(let i=0;i<canvas.width;i+=35){ctx.beginPath();ctx.moveTo(i,0);ctx.lineTo(i,canvas.height);ctx.stroke();}
      } else {
        ctx.fillStyle = `hsl(${t*30%360},70%,20%)`; ctx.fillRect(0,0,canvas.width,canvas.height);
        for(let p of worldParticles){ p.x += p.dx; p.y += p.dy; if(p.x<0)p.x=canvas.width; if(p.x>canvas.width)p.x=0; if(p.y<0)p.y=canvas.height; if(p.y>canvas.height)p.y=0; ctx.fillStyle=p.color; ctx.fillRect(p.x,p.y,p.size,p.size);}
      }
      for(let i=shootingStars.length-1;i>=0;i--){let s=shootingStars[i]; ctx.strokeStyle='white'; ctx.beginPath(); ctx.moveTo(s.x,s.y); ctx.lineTo(s.x-s.length*Math.cos(s.angle),s.y-s.length*Math.sin(s.angle)); ctx.stroke(); s.x+=s.speed*Math.cos(s.angle); s.y+=s.speed*Math.sin(s.angle); if(s.x>canvas.width||s.y>canvas.height)shootingStars.splice(i,1);}
    }

    // ----- PARTY NETWORKING -----
    function broadcastState() {
      if (!partyChannel || !roomId) return;
      const myState = {
        type: 'playerUpdate',
        room: roomId,
        sender: myPlayerId,
        x: player.x, y: player.y,
        color: player.color,
        health: player.health,
        combo: player.combo,
        isHost: isHost,
        timestamp: Date.now()
      };
      partyChannel.postMessage(myState);
    }

    function handleRemoteMessage(event) {
      if (!roomId || !gameActive) return;
      const data = event.data;
      if (!data || data.room !== roomId || data.sender === myPlayerId) return;
      
      if (data.type === 'playerUpdate') {
        let remote = remotePlayers.get(data.sender);
        if (!remote) {
          remote = { id: data.sender, color: data.color, health: 100, combo: 0, x: data.x, y: data.y };
          remotePlayers.set(data.sender, remote);
        }
        remote.x = data.x;
        remote.y = data.y;
        remote.health = data.health;
        remote.combo = data.combo;
        remote.color = data.color;
        
        // If remote player exists, we can replace AI enemy with remote (first remote becomes opponent)
        if (remotePlayers.size > 0 && enemy.isAI && aiEnabled) {
          // Convert enemy to represent remote player visually
          const firstRemote = remotePlayers.values().next().value;
          if (firstRemote) {
            enemy.isAI = false;
            enemy.id = firstRemote.id;
            enemy.color = firstRemote.color;
            aiEnabled = false;
          }
        }
      } else if (data.type === 'hostAnnounce' && isHost === false) {
        // acknowledge host
      }
    }

    function joinRoom(code) {
      if (partyChannel) partyChannel.close();
      roomId = code;
      partyChannel = new BroadcastChannel(channelName);
      partyChannel.onmessage = handleRemoteMessage;
      roomCodeText.textContent = `🏠 Room: ${roomId}`;
      isHost = false;
      // Clear previous remote players
      remotePlayers.clear();
      aiEnabled = true;
      enemy = createEnemy();
      if (player.health <= 0) resetGame();
    }

    function hostRoom() {
      if (partyChannel) partyChannel.close();
      roomId = Math.random().toString(36).substring(2, 8).toUpperCase();
      partyChannel = new BroadcastChannel(channelName);
      partyChannel.onmessage = handleRemoteMessage;
      isHost = true;
      roomCodeText.textContent = `🌟 HOST: ${roomId}`;
      remotePlayers.clear();
      aiEnabled = true;
      enemy = createEnemy();
      // Announce host presence
      partyChannel.postMessage({ type: 'hostAnnounce', room: roomId, sender: myPlayerId });
    }

    // UI events
    partyHostBtn.addEventListener('click', hostRoom);
    joinPartyBtn.addEventListener('click', () => {
      const code = prompt('Enter room code to join:').trim().toUpperCase();
      if (code) joinRoom(code);
    });

    charSelect.addEventListener('change', (e) => {
      playerColor = e.target.value;
      player.color = playerColor;
    });

    pauseBtn.addEventListener('click', () => { paused = !paused; });
    restartBtn.addEventListener('click', () => resetGame());

    function resetGame() {
      player = createPlayer(playerColor);
      enemy = createEnemy();
      particles = [];
      screenShake = 0;
      aiEnabled = true;
      remotePlayers.clear();
      gameActive = true;
    }

    function updateGame() {
      if (!gameActive || paused) return;
      
      const diff = parseInt(diffSlider.value);
      
      // Player movement
      if (keys['arrowleft']) player.x -= player.speed;
      if (keys['arrowright']) player.x += player.speed;
      if (keys['z']) player.attack(enemy, 'punch');
      if (keys['x']) player.attack(enemy, 'kick');
      if (keys['c'] && player.combo >= 3) player.special(enemy);
      
      player.update(enemy, diff);
      
      // Enemy update (AI or remote)
      if (enemy.isAI) {
        enemy.update(player, diff);
      } else {
        // Remote enemy controlled by another player: sync from remotePlayers
        const remoteEnemy = remotePlayers.get(enemy.id);
        if (remoteEnemy) {
          enemy.x = remoteEnemy.x;
          enemy.y = remoteEnemy.y;
          enemy.health = remoteEnemy.health;
          enemy.combo = remoteEnemy.combo;
        }
        enemy.attackTimer = Math.max(0, enemy.attackTimer - 1);
      }
      
      // Update remote players appearance (excluding the one acting as enemy)
      for (let [rid, data] of remotePlayers.entries()) {
        if (enemy.id === rid) continue;
        // additional remote fighters can be drawn but not interactive here
      }
      
      // Particles
      particles = particles.filter(p => p.lifetime > 0);
      particles.forEach(p => p.update());
      
      // Broadcast my state periodically
      if (roomId && partyChannel) {
        broadcastState();
      }
      
      // Win condition
      if (player.health <= 0 || enemy.health <= 0) {
        gameActive = false;
        setTimeout(() => {
          if (player.health <= 0 && enemy.health > 0) alert('💀 Defeated!');
          else if (enemy.health <= 0 && player.health > 0) alert('🏆 VICTORY!');
          resetGame();
          gameActive = true;
        }, 1800);
      }
    }

    function drawRemoteFighters() {
      for (let [rid, data] of remotePlayers.entries()) {
        if (enemy.id === rid) continue; // already drawn as enemy
        ctx.fillStyle = data.color;
        ctx.globalAlpha = 0.8;
        ctx.fillRect(data.x, data.y, 45, 75);
        ctx.fillStyle = 'white';
        ctx.font = '10px monospace';
        ctx.fillText('P' + rid.substring(0,4), data.x, data.y-8);
        ctx.globalAlpha = 1;
      }
    }

    function drawScene() {
      if (screenShake > 0) {
        ctx.save();
        ctx.translate(Math.random() * screenShake - screenShake/2, Math.random() * screenShake - screenShake/2);
        screenShake *= 0.9;
      }
      drawBackground();
      player.draw(ctx);
      enemy.draw(ctx, !enemy.isAI);
      drawRemoteFighters();
      
      // Particles
      for (let p of particles) p.draw(ctx);
      
      if (screenShake > 0) ctx.restore();
      
      // Room info on canvas
      if (roomId) {
        ctx.fillStyle = '#ffffffcc';
        ctx.font = 'bold 14px monospace';
        ctx.fillText(`👥 ${isHost?'HOST':'JOINED'}: ${roomId}`, 20, 35);
      }
    }

    function gameLoop() {
      if (!paused) {
        updateGame();
      }
      drawScene();
      requestAnimationFrame(gameLoop);
    }

    // Initialize default room hint
    roomCodeText.textContent = '🏠 No room (Host/Join)';
    
    // Start loop
    gameLoop();

    // Cleanup on page unload
    window.addEventListener('beforeunload', () => {
      if (partyChannel) partyChannel.close();
    });

  })();
</script>
</body>
</html>
